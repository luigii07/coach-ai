{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],

    "paths": {
      "@/*": ["./src/*"]
    },

    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "skipDefaultLibCheck": true
  }
}
